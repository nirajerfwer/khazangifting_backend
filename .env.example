DATABASE_URL=postgresql://neondb_owner:npg_W6JCdNXgY8rv@ep-fragrant-hill-am2pt0sn-pooler.c-5.us-east-1.aws.neon.tech/KhazanaGiftinDB?sslmode=require&channel_binding=require
FRONTEND=http://localhost:3000
NODE_ENV=development

# Generate strong random secrets for these, e.g. `openssl rand -hex 32`. Never commit real values.
JWT_SECRET=test
JWT_REFRESH_SECRET=test

# AWS S3 — the SDK picks up AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY automatically;
# never read these into request/response bodies or send them to the frontend.
AWS_REGION= lj
AWS_ACCESS_KEY_ID= jjk
AWS_SECRET_ACCESS_KEY=jlj
AWS_BUCKET_NAME=kj
# Optional: serve images via CloudFront instead of the raw S3 URL
AWS_CLOUDFRONT_DOMAIN=jlk

# Razorpay
RAZORPAY_KEY_ID= jlk
RAZORPAY_KEY_SECRET=jlk
RAZORPAY_WEBHOOK_SECRET=jk
