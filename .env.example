DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
FRONTEND=http://localhost:3000
NODE_ENV=development

# Generate strong random secrets for these, e.g. `openssl rand -hex 32`. Never commit real values.
JWT_SECRET=
JWT_REFRESH_SECRET=

# AWS S3 — the SDK picks up AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY automatically;
# never read these into request/response bodies or send them to the frontend.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# Optional: serve images via CloudFront instead of the raw S3 URL
AWS_CLOUDFRONT_DOMAIN=

# Razorpay (used once payment integration is implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
